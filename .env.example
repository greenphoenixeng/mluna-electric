# Resend API key for contact form email delivery
# Get one at https://resend.com — free tier is 3k emails/mo
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions
NOTIFY_EMAIL=contact@mlunaelectric.com

# Sender for the notification email — must be on a domain verified in Resend
FROM_EMAIL="M. Luna Electric Website <no-reply@mlunaelectric.com>"
