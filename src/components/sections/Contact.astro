---
import { SITE, TEL_HREF, MAILTO_HREF } from '@/data/site';

interface Props {
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;
---
<section class="contact" id="contact">
  <div class="contact-inner">
    <div class="contact-info fade-up">
      {showHeading && (
        <Fragment>
          <div class="section-label">Get in Touch</div>
          <h2 class="section-title">Let's Talk<br/>About Your<br/>Project</h2>
          <p class="section-sub">
            Fill out the form and we'll follow up within one business day with a free estimate. Rather talk? Call us directly.
          </p>
        </Fragment>
      )}
      <div class="contact-methods">
        <div class="contact-method">
          <div class="contact-method-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 010 1.18 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14v2.92z"/></svg>
          </div>
          <div>
            <div class="contact-method-label">Phone</div>
            <div class="contact-method-value"><a href={TEL_HREF}>{SITE.phoneDisplay}</a></div>
          </div>
        </div>
        <div class="contact-method">
          <div class="contact-method-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <div class="contact-method-label">Email</div>
            <div class="contact-method-value"><a href={MAILTO_HREF}>{SITE.email}</a></div>
          </div>
        </div>
        <div class="contact-method">
          <div class="contact-method-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <div class="contact-method-label">Location</div>
            <div class="contact-method-value">{SITE.address.locality}, {SITE.address.region}</div>
          </div>
        </div>
        <div class="contact-method">
          <div class="contact-method-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div>
            <div class="contact-method-label">Hours</div>
            <div class="contact-method-value">{SITE.hoursExtended}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="contact-form fade-up">
      <div class="form-title">Request a Free Quote</div>
      <form id="contact-form">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="fname">First Name</label>
            <input class="form-control" type="text" id="fname" name="fname" placeholder="Miguel" maxlength="60" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="lname">Last Name</label>
            <input class="form-control" type="text" id="lname" name="lname" placeholder="Luna" maxlength="60" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-control" type="email" id="email" name="email" placeholder="you@example.com" maxlength="254" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="phone">Phone</label>
            <input
              class="form-control"
              type="tel"
              id="phone"
              name="phone"
              placeholder={SITE.phoneDisplay}
              inputmode="tel"
              autocomplete="tel"
              maxlength="14"
              required
              aria-describedby="phone-error"
              title="Enter a 10-digit US phone number, e.g. (610) 546-5128"
            />
            <p id="phone-error" class="form-field-error" hidden>Enter a valid 10-digit US phone number</p>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="service">Service Needed</label>
          <select class="form-control" id="service" name="service">
            <option value="">Select a service...</option>
            <option>Residential Electrical</option>
            <option>Commercial / Office</option>
            <option>Panel Upgrade</option>
            <option>New Construction</option>
            <option>EV Charger Install</option>
            <option>Lighting &amp; Fixtures</option>
            <option>Generator Install</option>
            <option>Other / Not Sure</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="message">Project Description</label>
          <textarea class="form-control" id="message" name="message" placeholder="Tell us what you need — address, scope, timeline..." maxlength="5000" required></textarea>
        </div>
        <div class="form-group form-hp" aria-hidden="true">
          <label class="form-label" for="company">Company</label>
          <input class="form-control" type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="form-submit">Send My Quote Request →</button>
        <p id="form-status" class="form-status-msg" style="display:none; margin-top:12px; text-align:center; font-size:14px;"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .form-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-field-error {
    margin: 8px 0 0;
    font-size: 13px;
    color: #f87171;
  }
  .form-control.is-invalid {
    border-color: #f87171;
  }
</style>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const phoneInput = document.getElementById('phone');
  const phoneError = document.getElementById('phone-error');

  if (!form || !status) {
    console.error('contact form: #contact-form or #form-status is missing from the page');
  }

  function digitsOnly(value) {
    return value.replace(/\D/g, '').slice(0, 10);
  }

  /** Format as (XXX) XXX-XXXX from up to 10 digits. */
  function formatPhone(value) {
    const d = digitsOnly(value);
    if (d.length === 0) return '';
    if (d.length < 4) return `(${d}`;
    if (d.length < 7) return `(${d.slice(0, 3)}) ${d.slice(3)}`;
    return `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
  }

  function isValidPhone(value) {
    return digitsOnly(value).length === 10;
  }

  function setPhoneError(show) {
    if (!phoneInput || !phoneError) return;
    phoneInput.classList.toggle('is-invalid', show);
    phoneInput.setCustomValidity(show ? 'Enter a valid 10-digit US phone number' : '');
    phoneError.hidden = !show;
  }

  function validatePhone() {
    if (!phoneInput || !phoneError) return true;
    const value = phoneInput.value.trim();
    if (!value) {
      phoneError.textContent = 'Phone number is required';
      setPhoneError(true);
      return false;
    }
    const ok = isValidPhone(value);
    phoneError.textContent = 'Enter a valid 10-digit US phone number';
    setPhoneError(!ok);
    return ok;
  }

  phoneInput?.addEventListener('keyup', () => {
    const formatted = formatPhone(phoneInput.value);
    if (phoneInput.value !== formatted) {
      phoneInput.value = formatted;
    }
    if (formatted) validatePhone();
    else setPhoneError(false);
  });

  phoneInput?.addEventListener('input', () => {
    const formatted = formatPhone(phoneInput.value);
    if (phoneInput.value !== formatted) {
      phoneInput.value = formatted;
    }
  });

  phoneInput?.addEventListener('blur', validatePhone);

  phoneInput?.addEventListener('keydown', (e) => {
    if (
      e.ctrlKey || e.metaKey || e.altKey ||
      e.key === 'Backspace' || e.key === 'Delete' ||
      e.key === 'Tab' || e.key === 'Escape' || e.key === 'Enter' ||
      e.key.startsWith('Arrow') || e.key === 'Home' || e.key === 'End'
    ) {
      return;
    }
    if (!/^\d$/.test(e.key)) {
      e.preventDefault();
      return;
    }
    if (digitsOnly(phoneInput.value).length >= 10 && phoneInput.selectionStart === phoneInput.selectionEnd) {
      e.preventDefault();
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status) return;

    const field = (name) =>
      form.elements.namedItem(name)?.value ?? '';

    if (phoneInput) phoneInput.value = formatPhone(phoneInput.value);

    if (!validatePhone()) {
      phoneInput?.focus();
      phoneInput?.reportValidity();
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const submit = form.querySelector('.form-submit');
    const data = {
      name: `${field('fname')} ${field('lname')}`.trim(),
      email: field('email'),
      phone: field('phone'),
      service: field('service'),
      message: field('message'),
      company: field('company'),
    };

    status.style.display = 'block';
    status.style.color = 'var(--muted)';
    status.textContent = 'Sending...';
    if (submit) submit.disabled = true;

    const fail = (msg) => {
      status.style.color = '#f87171';
      status.textContent = msg;
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      let payload = {};
      try {
        payload = await res.json();
      } catch (err) {
        console.error('contact form: response was not valid JSON', err);
      }

      if (!res.ok) {
        console.error(`contact form: server responded ${res.status}`, payload);
        if (payload.error === 'Invalid phone number') {
          fail('Please enter a valid 10-digit phone number.');
        } else if (res.status >= 400 && res.status < 500 && payload.error) {
          fail(payload.error);
        } else {
          fail('Something went wrong. Please call us directly.');
        }
        return;
      }

      status.style.color = '#4ade80';
      status.textContent = "✓ Message sent! We'll follow up within one business day.";
      form.reset();
      setPhoneError(false);
    } catch (err) {
      console.error('contact form: submission request failed', err);
      fail('Could not reach the server. Please check your connection or call us directly.');
    } finally {
      if (submit) submit.disabled = false;
    }
  });
</script>
