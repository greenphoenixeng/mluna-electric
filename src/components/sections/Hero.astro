---
import { Image } from 'astro:assets';
import heroBg from '@/assets/images/Gemini-hero.png';
---
<section class="hero" id="home">
  <div class="hero-bg">
    <Image src={heroBg} alt="" class="hero-bg-img" />
    <div class="hero-bg-overlay"></div>
  </div>
  <div class="hero-grid"></div>

  <svg class="hero-bolt-deco" viewBox="0 0 300 500" fill="none" xmlns="http://www.w3.org/2000/svg">
    <polygon points="180,10 60,240 145,240 120,490 240,200 155,200" fill="#FF672B"/>
  </svg>

  <div class="hero-content">
    <div class="hero-badge">PA & DE Licensed · Kennett Square, PA</div>
    <h1>Wired Right.<br/>The First <em>Time.</em></h1>
    <p class="hero-sub">
      Chester County's trusted electrical contractor since 2004. Master licensed, family-owned — residential panels to full commercial builds, done right across Chester &amp; Delaware County.
    </p>
    <div class="hero-actions">
      <a href="#contact" class="btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
        Get a Free Quote
      </a>
      <a href="#services" class="btn-ghost">
        Our Services
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <p class="hero-license">Licensed in Delaware and Pennsylvania</p>
  </div>
</section>
