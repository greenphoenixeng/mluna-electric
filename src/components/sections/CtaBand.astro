---
import { MAILTO_HREF } from '@/data/site';

interface Props {
  heading?: string;
  body?: string;
  quoteHref?: string;
  icons?: boolean;
}

const {
  heading = 'Ready to Get<br/>Started?',
  body = "Tell us about your project — we'll get back to you within one business day with a quote.",
  quoteHref = '#contact',
  icons = true,
} = Astro.props;
---
<div class="cta-band">
  <div class="cta-band-inner">
    <h2 set:html={heading} />
    <p>{body}</p>
    <div class="cta-band-actions">
      <a href={quoteHref} class="btn-dark">
        {icons && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
        )}
        Request a Free Quote
      </a>
      <a href={MAILTO_HREF} class="btn-white">
        {icons && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
        )}
        Email Us
      </a>
    </div>
  </div>
</div>
