---
import SiteLogo from '@/components/SiteLogo.astro';
import { SITE, TEL_HREF, MAILTO_HREF } from '@/data/site';
---
<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <SiteLogo href="#home" style="display:inline-flex; margin-bottom:16px; font-size:20px;" />
      <p class="footer-brand-sub">
        Licensed electrical contractor serving Chester &amp; Delaware County, PA. Residential, commercial, and new construction.
      </p>
    </div>

    <div>
      <div class="footer-col-title">Company</div>
      <ul class="footer-links">
        <li><a href="#about">About Us</a></li>
        <li><a href="#why">Why Choose Us</a></li>
        <li><a href="#area">Service Area</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="#contact">Free Quote</a></li>
      </ul>
    </div>

    <div>
      <div class="footer-col-title">Contact</div>
      <ul class="footer-links">
        <li><a href={TEL_HREF}>{SITE.phoneDisplay}</a></li>
        <li><a href={MAILTO_HREF}>{SITE.email}</a></li>
        <li style="color:var(--mid); cursor:default;">{SITE.address.locality}, {SITE.address.region}</li>
        <li style="color:var(--mid); cursor:default;">Chester &amp; Delaware County</li>
        <li style="color:var(--mid); cursor:default; margin-top:4px;">{SITE.hours}</li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div>© 2026 M. Luna Electric. All rights reserved.</div>
    <div class="footer-license">🔌 PA License PA145866 · DE License T1-0006293</div>
    <div>
      <a href="/privacy">Privacy Policy</a> &nbsp;·&nbsp;
      <a href="/terms">Terms</a>
    </div>
  </div>
</footer>
