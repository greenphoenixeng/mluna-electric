---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import FadeUpObserver from '@/components/FadeUpObserver.astro';
import { Image } from 'astro:assets';

import photo267 from '@/assets/images/IMG_0267.jpeg';
import photo163 from '@/assets/images/IMG_0163.jpeg';
import moema15 from '@/assets/images/moema-15.jpg';

import elec03 from '@/assets/images/elec-03.jpg';
import elec09 from '@/assets/images/elec-09.jpg';
import elec15 from '@/assets/images/elec-15.jpg';
import elec16 from '@/assets/images/elec-16.jpg';
import elec18 from '@/assets/images/elec-18.jpg';
import elec20 from '@/assets/images/elec-20.jpg';
import elec22 from '@/assets/images/elec-22.jpg';
import elec23 from '@/assets/images/elec-23.jpg';
import elec25 from '@/assets/images/elec-25.jpg';
import elec27 from '@/assets/images/elec-27.jpg';

const teamPhotos = [
  { src: elec16, alt: 'The full M. Luna Electric team' },
  { src: elec15, alt: 'The M. Luna Family' },
  { src: elec25, alt: 'M. Luna gents' },
];
---

<Layout
  title="About M. Luna Electric | Licensed Electrician — Kennett Square, PA"
  description="M. Luna Electric is a family-owned electrical contractor based in Kennett Square, PA — the mushroom capital of the world. Master licensed, bilingual, serving Chester & Delaware County."
>
  <Nav />

  <PageHero
    label="About Us"
    title="Built on<br/>Craftsmanship<br/>&amp; Reliability"
    sub="Family-owned. Kennett Square-based. 20+ years of honest electrical work across Chester and Delaware County."
  />

  <section class="about-pg-story">
    <div class="about-pg-story-inner">
      <div class="about-pg-photo fade-up">
        <div class="about-pg-img-wrap">
          <Image src={moema15} alt="M. Luna Electric crew on a Kennett Square project" width={900} quality={85} />
          <div class="about-pg-overlay"></div>
        </div>
        <div class="about-pg-badge">
          <span class="about-pg-badge-num">20+</span>
          <span class="about-pg-badge-text">Years Serving<br/>Chester County</span>
        </div>
      </div>

      <div class="about-pg-text fade-up">
        <div class="section-label">Our Story</div>
        <h2 class="section-title" style="font-size: clamp(36px,5vw,56px);">Built from<br/>the Ground Up</h2>
        <p class="section-sub"><strong style="color:var(--orange);font-family:'Barlow Condensed',sans-serif;font-size:13px;letter-spacing:.08em;text-transform:uppercase;">The Foundation (2004–2017)</strong><br/>
          Miguel Luna Cruz began his electrical journey in 2004, spending over a decade mastering the trade's complexities. His dedication culminated in 2018 when he earned his Master Electrician license — providing the foundation to launch M. Luna Electric as a solo operation with one truck.
        </p>
        <p class="section-sub" style="margin-top: 20px;"><strong style="color:var(--orange);font-family:'Barlow Condensed',sans-serif;font-size:13px;letter-spacing:.08em;text-transform:uppercase;">Growth &amp; Specialization</strong><br/>
          The business found its footing in Kennett Square — <span class="mushroom-capital">🍄 the mushroom capital of the world</span> — where a large portion of our work is with local mushroom farms. Precision and reliability aren't optional there. The reputation built on those jobs allowed M. Luna Electric to expand across Chester and Delaware County and eventually serve clients out of state — before officially incorporating.
        </p>
        <p class="section-sub" style="margin-top: 20px;"><strong style="color:var(--orange);font-family:'Barlow Condensed',sans-serif;font-size:13px;letter-spacing:.08em;text-transform:uppercase;">M. Luna Electric Today</strong><br/>
          Driven by a loyal and growing client base, the company officially incorporated. Today, M. Luna Electric, Inc. is still family-run, still built on the same principles from day one — licensed in Delaware and Pennsylvania.
        </p>
        <blockquote class="about-pg-quote">"We are still small, but we hope to grow by continuously helping our clients." — Miguel Luna Cruz</blockquote>
      </div>
    </div>
  </section>

  <section class="about-pg-license-band">
    <p class="about-pg-license-text">Licensed in Delaware and Pennsylvania</p>
    <div class="about-pg-license">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      PA Electrical Contractor License: <strong>PA145866</strong>
    </div>
  </section>

  <section class="about-pg-values">
    <div class="about-pg-values-inner">
      <div class="about-pg-values-header fade-up">
        <div class="section-label">What We Stand For</div>
        <h2 class="section-title" style="font-size: clamp(36px,5vw,56px);">The Difference<br/>Is in the Details</h2>
      </div>
      <div class="about-pg-values-grid">
        {[
          { num: '01', title: 'On-Time, Every Time',   body: 'We respect your schedule. If we\'re running late, you\'ll hear from us before you have to call.' },
          { num: '02', title: 'Code Compliant',         body: 'Every job done to current NEC and PA state code. We pull permits and pass inspections — no shortcuts.' },
          { num: '03', title: 'Upfront Pricing',        body: 'You know the price before we start. No surprise invoices, no upsells mid-job.' },
          { num: '04', title: 'Bilingual Team',         body: 'We communicate in English and Spanish so nothing gets lost in translation.' },
          { num: '05', title: 'GC-Ready Crew',          body: 'We sequence, communicate, and deliver clean rough-ins that pass every time.' },
          { num: '06', title: 'Local &amp; Accountable', body: 'We live here too. Our reputation in Chester County is built one job at a time.' },
        ].map(v => (
          <div class="about-pg-value fade-up">
            <div class="about-pg-value-num">{v.num}</div>
            <div class="about-pg-value-title" set:html={v.title} />
            <p class="about-pg-value-body">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-pg-gallery">
    <div class="about-pg-gallery-wrap">
      <div class="about-pg-gallery-header fade-up">
        <div class="section-label">Meet the Team</div>
        <h2 class="section-title" style="font-size: clamp(36px,5vw,56px);">The Crew Behind<br/>the Work</h2>
        <p class="section-sub">
          From the field to the front office — the people who show up, get it done, and stand behind every job.
        </p>
      </div>
      <div class="about-pg-gallery-inner">
        {teamPhotos.map((photo) => (
          <button type="button" class="about-pg-gallery-img fade-up" aria-label={`View larger: ${photo.alt}`}>
            <Image src={photo.src} alt={photo.alt} width={1200} quality={85} />
          </button>
        ))}
      </div>
    </div>
  </section>

  <div class="about-lightbox" id="team-lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Enlarged team photo">
    <button type="button" class="about-lightbox-backdrop" aria-label="Close"></button>
    <figure class="about-lightbox-figure">
      <img class="about-lightbox-img" src="" alt="" />
      <figcaption class="about-lightbox-caption"></figcaption>
    </figure>
    <button type="button" class="about-lightbox-close" aria-label="Close">&times;</button>
  </div>

  <section class="about-pg-mission">
    <div class="about-pg-mission-inner">
      <div class="about-pg-mission-text fade-up">
        <div class="section-label">Our Mission</div>
        <h2 class="section-title" style="font-size: clamp(32px,4.5vw,52px);">Family.<br/>Integrity.<br/>Community.</h2>
        <p class="section-sub" style="margin-top: 24px;">
          At M. Luna Electric, Inc., our business is built on family — and that extends to every client we serve. Miguel's daughter manages the office while pursuing her bachelor's degree. His son is training at Lincoln Tech to become the next generation of Master Electricians.
        </p>
        <p class="section-sub" style="margin-top: 16px;">
          We put our clients' needs before our profits. Whether handling a residential update or a complex commercial project, our job isn't done when the power turns on — we believe in building lasting relationships through dedicated post-project care and reliable service.
        </p>
      </div>
      <div class="about-pg-mission-cards fade-up">
        <div class="about-mission-card">
          <div class="about-mission-card-title">Family-Owned &amp; Operated</div>
          <p class="about-mission-card-body">Three generations of the Luna family invested in every job — from the field to the front office.</p>
        </div>
        <div class="about-mission-card">
          <div class="about-mission-card-title">Clients Before Profits</div>
          <p class="about-mission-card-body">We prioritize your outcome over our margin. Transparent pricing, no upsells mid-job.</p>
        </div>
        <div class="about-mission-card">
          <div class="about-mission-card-title">Post-Project Care</div>
          <p class="about-mission-card-body">The job isn't done when the power turns on. We stand behind our work and maintain the relationship.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Ready to Work<br/>Together?"
    body="Get a free estimate — we respond within one business day."
    quoteHref="/#contact"
    icons={false}
  />

  <Footer />
</Layout>

<style>
  .about-pg-story { background: var(--dark); padding: 100px 5%; }
  .about-pg-story-inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
  }
  .about-pg-img-wrap {
    position: relative; border-radius: 4px; overflow: hidden;
    aspect-ratio: 3/4;
  }
  .about-pg-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .about-pg-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,0.5) 0%, transparent 60%);
  }
  .about-pg-badge {
    position: absolute; bottom: 24px; left: 24px;
    background: var(--orange);
    padding: 16px 20px; border-radius: 4px;
    display: flex; flex-direction: column;
  }
  .about-pg-badge-num {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 40px; font-weight: 800; line-height: 1;
    color: #000;
  }
  .about-pg-badge-text { font-size: 12px; font-weight: 700; color: rgba(0,0,0,0.7); line-height: 1.3; }

  .about-pg-license-band {
    background: var(--black);
    padding: 48px 5%;
    border-top: 1px solid var(--dark3);
    border-bottom: 1px solid var(--dark3);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .about-pg-license-text {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--white);
  }

  .about-pg-license {
    display: inline-flex; align-items: center; gap: 10px;
    margin: 0; padding: 12px 18px;
    background: rgba(255,103,43,0.08);
    border: 1px solid rgba(255,103,43,0.25);
    border-radius: 4px;
    font-size: 14px; color: var(--light);
  }
  .about-pg-license svg { color: var(--orange); flex-shrink: 0; }
  .about-pg-license strong { color: var(--orange); }

  .about-pg-values { background: var(--dark2); padding: 100px 5%; }
  .about-pg-values-inner { max-width: 1200px; margin: 0 auto; }
  .about-pg-values-header { margin-bottom: 60px; }
  .about-pg-values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .about-pg-value {
    background: var(--dark); padding: 40px 32px;
    border: 1px solid var(--dark3);
  }
  .about-pg-value-num {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 14px; font-weight: 700; color: var(--orange);
    letter-spacing: 0.1em; margin-bottom: 16px;
  }
  .about-pg-value-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 22px; font-weight: 800; text-transform: uppercase;
    color: var(--white); margin-bottom: 12px;
  }
  .about-pg-value-body { font-size: 15px; color: var(--muted); line-height: 1.65; }

  .about-pg-gallery { background: var(--black); padding: 80px 5%; }
  .about-pg-gallery-wrap {
    max-width: 1400px;
    margin: 0 auto;
  }
  .about-pg-gallery-header { margin-bottom: 48px; }
  .about-pg-gallery-header .section-sub { margin-top: 16px; }
  .about-pg-gallery-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    justify-content: center;
  }
  .about-pg-gallery-img {
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 4px;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: 0;
    border: none;
    background: var(--dark2);
    cursor: pointer;
    display: block;
  }
  .about-pg-gallery-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .about-pg-gallery-img:hover img,
  .about-pg-gallery-img:focus-visible img {
    transform: scale(1.06);
  }

  .about-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  .about-lightbox[hidden] { display: none; }
  .about-lightbox-backdrop {
    position: absolute;
    inset: 0;
    border: none;
    padding: 0;
    background: rgba(0, 0, 0, 0.88);
    cursor: zoom-out;
  }
  .about-lightbox-figure {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: min(1100px, 94vw);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: about-lightbox-in 0.25s ease;
  }
  .about-lightbox-img {
    max-width: 100%;
    max-height: calc(88vh - 40px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.55);
  }
  .about-lightbox-caption {
    margin-top: 14px;
    font-size: 14px;
    color: var(--muted);
    text-align: center;
    max-width: 640px;
  }
  .about-lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s;
  }
  .about-lightbox-close:hover { background: rgba(255, 103, 43, 0.85); color: #000; }
  @keyframes about-lightbox-in {
    from { opacity: 0; transform: scale(0.92); }
    to { opacity: 1; transform: scale(1); }
  }
  body.lightbox-open { overflow: hidden; }

  @media (min-width: 640px) {
    .about-pg-gallery-inner {
      grid-template-columns: repeat(2, minmax(0, 640px));
      gap: 20px;
    }
    .about-pg-gallery-img { max-width: none; }
  }
  @media (min-width: 1100px) {
    .about-pg-gallery-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }

  .about-pg-quote {
    margin-top: 28px; padding: 20px 24px;
    border-left: 3px solid var(--orange);
    background: rgba(255,103,43,0.04);
    font-size: 16px; font-style: italic; color: var(--light);
    line-height: 1.65; border-radius: 0;
  }

  .about-pg-mission {
    background: var(--dark);
    padding: 100px 5%;
    border-top: 1px solid var(--dark3);
  }
  .about-pg-mission-inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start;
  }
  .about-pg-mission-cards { display: flex; flex-direction: column; gap: 16px; padding-top: 8px; }
  .about-mission-card {
    padding: 28px 32px;
    background: var(--dark2);
    border: 1px solid var(--dark3);
    border-left: 3px solid var(--orange);
    border-radius: 0;
  }
  .about-mission-card-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px; font-weight: 800; text-transform: uppercase;
    color: var(--white); margin-bottom: 8px; letter-spacing: 0.02em;
  }
  .about-mission-card-body { font-size: 15px; color: var(--muted); line-height: 1.65; margin: 0; }

  @media (max-width: 1024px) {
    .about-pg-mission-inner { grid-template-columns: 1fr; gap: 48px; }
  }

  @media (max-width: 1024px) {
    .about-pg-story-inner { grid-template-columns: 1fr; gap: 48px; }
    .about-pg-values-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .about-pg-license-text { font-size: 16px; }
    .about-pg-values-grid { grid-template-columns: 1fr; }
  }
</style>

<FadeUpObserver />

<script>
  const lightbox = document.getElementById('team-lightbox');
  const lightboxImg = lightbox?.querySelector('.about-lightbox-img');
  const lightboxCaption = lightbox?.querySelector('.about-lightbox-caption');
  const thumbs = document.querySelectorAll('.about-pg-gallery-img');

  function openLightbox(thumb) {
    if (!lightbox || !lightboxImg || !lightboxCaption) return;
    const img = thumb.querySelector('img');
    if (!img) return;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    lightboxCaption.textContent = img.alt;
    lightbox.hidden = false;
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('lightbox-open');
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('lightbox-open');
  }

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => openLightbox(thumb));
  });

  lightbox?.querySelector('.about-lightbox-backdrop')?.addEventListener('click', closeLightbox);
  lightbox?.querySelector('.about-lightbox-close')?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) closeLightbox();
  });
</script>
